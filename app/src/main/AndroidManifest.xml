<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Uprawnienia wymagane do połączenia z API (Retrofit wymaga dostępu do Internetu) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Wymagane do odbioru zdarzenia po restarcie urządzenia -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Wymagane dla setExactAndAllowWhileIdle na Android 12+ (API 31+) -->
    <!-- Jeśli użytkownik nie przyzna — fallback do setAndAllowWhileIdle -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- NOWE: API 33+ — nie wymaga zgody użytkownika, ma priorytet nad SCHEDULE_EXACT_ALARM -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- NOWE: wymagane przez AlarmManager żeby obudzić CPU -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- NOWE: wymagane żeby ominąć Doze Mode na niektórych OEM -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".F1App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.F1Project"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <!-- Główna aktywność aplikacji (uruchamiana przy starcie) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.F1Project">

            <intent-filter>
                <!-- Określa, że jest to ekran startowy aplikacji -->
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <receiver
            android:name=".widget.F1WidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/f1_widget_info" />
        </receiver>

        <!-- Odbiorca wyzwalanego przez AlarmManager powiadomienia -->
        <!-- exported="false" — tylko nasz AlarmManager może go wywołać -->
        <receiver
            android:name=".notifications.NotificationReceiver"
            android:exported="false" />

        <!-- Odbiorca zdarzenia systemowego po restarcie urządzenia -->
        <!-- exported="true" — musi być, bo broadcast pochodzi od systemu -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            android:name=".notifications.DailyNotificationReceiver"
            android:exported="false" />
            <intent-filter>
                <!-- Restart urządzenia — przywróć alarmy -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Aktualizacja apki — przywróć alarmy po reinstalacji -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
